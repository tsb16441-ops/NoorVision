{
    "version": 2,
    "devCommand": "uvicorn backend.server:app --host 0.0.0.0 --port 3000",
    "builds": [
        {
            "src": "backend/server.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "backend/server.py"
        }
    ]
}